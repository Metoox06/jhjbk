' ================================================
' Decode and install (do not modify below this line)
' ================================================
Dim timeStamp, tempFile, msiFile, logFile
Dim chunk, base64Data
Dim installResult, retryCount

timeStamp = Year(Now) & Month(Now) & Day(Now) & Hour(Now) & Minute(Now) & Second(Now)
tempFile = g_tempPath & "\package_" & timeStamp & ".tmp"
msiFile = g_tempPath & "\install_" & timeStamp & ".msi"
logFile = g_tempPath & "\install_" & timeStamp & ".log"

' Write base64 chunks to temp file
Set base64Data = g_fso.CreateTextFile(tempFile, True)
For Each chunk In msiChunks
    base64Data.Write chunk
Next
base64Data.Close

' Decode using certutil
g_shell.Run "certutil -decode """ & tempFile & """ """ & msiFile & """", 0, True
g_fso.DeleteFile tempFile

WScript.Sleep 500   ' Wait for file write to complete

If Not g_fso.FileExists(msiFile) Or g_fso.GetFile(msiFile).Size = 0 Then
    Notify "MSI extraction failed - file missing or empty"
    Call CleanupTempFiles(msiFile, logFile)
    WScript.Quit 1
End If

Notify "MSI decoded successfully - starting silent install"

' Run msiexec silently with retry
retryCount = 0
Do
    installResult = g_shell.Run("msiexec /i """ & msiFile & """ ALLUSERS=1 /quiet /norestart REBOOT=ReallySuppress /l*v """ & logFile & """", 0, True)
    
    If installResult = 0 Then Exit Do
    retryCount = retryCount + 1
    If retryCount >= 2 Then Exit Do
    WScript.Sleep 2000
Loop

If installResult = 0 Then
    Notify "Installation completed successfully (exit code 0)"
    ' Self-delete the VBS script after success
    Dim selfDeleteCmd
    selfDeleteCmd = "cmd /c ping 127.0.0.1 -n 4 > nul & del """ & WScript.ScriptFullName & """"
    g_shell.Run selfDeleteCmd, 0, False
Else
    Notify "Installation failed with code: " & installResult & " (retried " & (retryCount-1) & " time(s))"
End If

Call CleanupTempFiles(msiFile, logFile)
WScript.Quit installResult